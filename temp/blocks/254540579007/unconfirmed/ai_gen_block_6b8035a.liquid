    create a section to store one background image and multiple collection that content start from add align property to shift alginment , and if inside also we can mange alignment , and we can also have  heading , subheading , and collection level we have image of that collection we can link with the url ,and we can change the border radius and inside the image we have a button and button have own link and if button have border radius and font size , weight , box shadow , padding , margin , in  every section block , and background image is full width and height auto adujst accounding to viewport and inside the content now content overflow
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-showcase-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: 400px;
    display: block;
  }

  .ai-collection-showcase__background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .ai-collection-showcase__background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-showcase__background-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-showcase__background-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-collection-showcase__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    padding: {{ block.settings.content_padding_top }}px {{ block.settings.content_padding_horizontal }}px {{ block.settings.content_padding_bottom }}px;
    text-align: {{ block.settings.content_alignment }};
    max-width: 100%;
    overflow-x: auto;
  }

  .ai-collection-showcase__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    font-size: {{ block.settings.heading_font_size }}px;
    font-weight: {{ block.settings.heading_font_weight }};
  }

  .ai-collection-showcase__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    margin: 0 0 {{ block.settings.subheading_margin_bottom }}px;
    font-size: {{ block.settings.subheading_font_size }}px;
    font-weight: {{ block.settings.subheading_font_weight }};
  }

  .ai-collection-showcase__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.grid_margin_top }}px;
  }

  .ai-collection-showcase__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.item_border_radius }}px;
  }

  .ai-collection-showcase__item-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.item_border_radius }}px;
  }

  .ai-collection-showcase__item-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    min-height: 300px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.item_border_radius }}px;
  }

  .ai-collection-showcase__item-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-collection-showcase__item-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.item_content_padding }}px;
    text-align: {{ block.settings.item_content_alignment }};
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.item_content_alignment }};
  }

  .ai-collection-showcase__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    margin: {{ block.settings.button_margin_vertical }}px {{ block.settings.button_margin_horizontal }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    box-shadow: {{ block.settings.button_shadow_horizontal }}px {{ block.settings.button_shadow_vertical }}px {{ block.settings.button_shadow_blur }}px {{ block.settings.button_shadow_color }};
    transition: all 0.3s ease;
  }

  .ai-collection-showcase__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-collection-showcase__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-collection-showcase__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_font_size }}px * 0.8);
    }

    .ai-collection-showcase__subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_font_size }}px * 0.8);
    }
  }
{% endstyle %}

<collection-showcase-{{ ai_gen_id }} class="ai-collection-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-showcase__background-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-collection-showcase__background-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-collection-showcase__content-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-collection-showcase__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <div class="ai-collection-showcase__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
    {% endif %}

    <div class="ai-collection-showcase__grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection_image_key = 'collection_' | append: i | append: '_image'
          assign collection_url_key = 'collection_' | append: i | append: '_url'
          assign button_text_key = 'collection_' | append: i | append: '_button_text'
          assign button_url_key = 'collection_' | append: i | append: '_button_url'

          assign collection = block.settings[collection_key]
          assign collection_image = block.settings[collection_image_key]
          assign collection_url = block.settings[collection_url_key]
          assign button_text = block.settings[button_text_key]
          assign button_url = block.settings[button_url_key]
        %}

        {% if collection != blank or collection_image != blank %}
          <div class="ai-collection-showcase__item-{{ ai_gen_id }}">
            {% if collection_url != blank %}
              <a href="{{ collection_url }}">
            {% elsif collection != blank %}
              <a href="{{ collection.url }}">
            {% endif %}

            {% if collection_image != blank %}
              <img
                src="{{ collection_image | image_url: width: 800 }}"
                alt="{{ collection_image.alt | escape }}"
                loading="lazy"
                width="{{ collection_image.width }}"
                height="{{ collection_image.height }}"
                class="ai-collection-showcase__item-image-{{ ai_gen_id }}"
              >
            {% elsif collection != blank and collection.featured_image %}
              <img
                src="{{ collection.featured_image | image_url: width: 800 }}"
                alt="{{ collection.featured_image.alt | escape }}"
                loading="lazy"
                width="{{ collection.featured_image.width }}"
                height="{{ collection.featured_image.height }}"
                class="ai-collection-showcase__item-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-collection-showcase__item-image-placeholder-{{ ai_gen_id }}">
                {{ 'collection-apparel-1' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if collection_url != blank or collection != blank %}
              </a>
            {% endif %}

            <div class="ai-collection-showcase__item-content-{{ ai_gen_id }}">
              {% if button_text != blank %}
                <a
                  href="{% if button_url != blank %}{{ button_url }}{% elsif collection != blank %}{{ collection.url }}{% else %}#{% endif %}"
                  class="ai-collection-showcase__button-{{ ai_gen_id }}"
                >
                  {{ button_text }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</collection-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionShowcase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.adjustBackgroundHeight();
        window.addEventListener('resize', () => this.adjustBackgroundHeight());
      }

      adjustBackgroundHeight() {
        const content = this.querySelector('.ai-collection-showcase__content-{{ ai_gen_id }}');
        const background = this.querySelector('.ai-collection-showcase__background-{{ ai_gen_id }}');
        if (content && background) {
          const contentHeight = content.offsetHeight;
          this.style.minHeight = contentHeight + 'px';
        }
      }
    }

    customElements.define('collection-showcase-{{ ai_gen_id }}', CollectionShowcase{{ ai_gen_id }});
  })();
</script>


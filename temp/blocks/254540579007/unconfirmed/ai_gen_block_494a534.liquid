{% doc %}
  @prompt
    we have a background image . and we have a multiple collection , inside the collections we have a main heading and subheading , and we can upload one image also and attach with collection page and we have button also to redirect to that collection page , we can style everything like border , color , shadow , font color , font size , font weight , button radius , and many more 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-showcase-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    display: block;
  }

  .ai-collection-showcase-bg-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .ai-collection-showcase-bg-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-showcase-bg-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
  }

  .ai-collection-showcase-bg-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-showcase-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  .ai-collection-showcase-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
  }

  .ai-collection-showcase-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-collection-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_bg_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px {{ block.settings.card_shadow_color }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.card_content_gap }}px;
  }

  .ai-collection-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.card_hover_lift }}px);
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical | plus: block.settings.card_hover_lift }}px {{ block.settings.card_shadow_blur | plus: 4 }}px {{ block.settings.card_shadow_color }};
  }

  .ai-collection-card-image-{{ ai_gen_id }} {
    width: 100%;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-collection-card-image-{{ ai_gen_id }} img {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    object-fit: cover;
    display: block;
  }

  .ai-collection-card-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-card-text-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_gap }}px;
  }

  .ai-collection-card-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-collection-card-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    font-weight: {{ block.settings.subheading_weight }};
    margin: 0;
    line-height: 1.4;
  }

  .ai-collection-card-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    text-align: center;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-collection-card-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-collection-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #666;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-showcase-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-collection-showcase-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px {{ block.settings.section_padding_horizontal | times: 0.6 }}px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-collection-card-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-collection-card-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<collection-showcase-{{ ai_gen_id }} class="ai-collection-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-showcase-bg-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-collection-showcase-bg-placeholder-{{ ai_gen_id }}">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-collection-showcase-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-collection-showcase-content-{{ ai_gen_id }}">
    <div class="ai-collection-showcase-grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign heading_key = 'heading_' | append: i
          assign subheading_key = 'subheading_' | append: i
          assign image_key = 'image_' | append: i
          assign button_text_key = 'button_text_' | append: i

          assign collection = block.settings[collection_key]
          assign heading = block.settings[heading_key]
          assign subheading = block.settings[subheading_key]
          assign image = block.settings[image_key]
          assign button_text = block.settings[button_text_key]
        %}

        {% if collection != blank %}
          <div class="ai-collection-card-{{ ai_gen_id }}">
            <div class="ai-collection-card-image-{{ ai_gen_id }}">
              {% if image %}
                <img
                  src="{{ image | image_url: width: 600 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="600"
                  height="{{ block.settings.image_height }}"
                >
              {% elsif collection.image %}
                <img
                  src="{{ collection.image | image_url: width: 600 }}"
                  alt="{{ collection.image.alt | escape }}"
                  loading="lazy"
                  width="600"
                  height="{{ block.settings.image_height }}"
                >
              {% else %}
                <div class="ai-collection-card-image-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-collection-card-text-{{ ai_gen_id }}">
              {% if heading != blank %}
                <h3 class="ai-collection-card-heading-{{ ai_gen_id }}">{{ heading }}</h3>
              {% else %}
                <h3 class="ai-collection-card-heading-{{ ai_gen_id }}">{{ collection.title }}</h3>
              {% endif %}

              {% if subheading != blank %}
                <p class="ai-collection-card-subheading-{{ ai_gen_id }}">{{ subheading }}</p>
              {% endif %}

              <a
                href="{{ collection.url }}"
                class="ai-collection-card-button-{{ ai_gen_id }}"
              >
                {% if button_text != blank %}
                  {{ button_text }}
                {% else %}
                  Shop now
                {% endif %}
              </a>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings.collection_1 == blank and block.settings.collection_2 == blank and block.settings.collection_3 == blank and block.settings.collection_4 == blank and block.settings.collection_5 == blank and block.settings.collection_6 == blank %}
      <div class="ai-collection-empty-state-{{ ai_gen_id }}">
        Next, select collections to showcase
      </div>
    {% endif %}
  </div>
</collection-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionShowcase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('collection-showcase-{{ ai_gen_id }}', CollectionShowcase{{ ai_gen_id }});
  })();
</script>


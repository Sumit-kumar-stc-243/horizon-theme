<script>
  (function() {
    class AnnouncementBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.messages = [];
        this.interval = null;
      }

      connectedCallback() {
        this.messages = Array.from(this.querySelectorAll('.ai-announcement-bar__message-{{ ai_gen_id }}'));
        
        if (this.messages.length <= 1) {
          return;
        }

        const intervalSeconds = parseInt(this.dataset.interval) || 5;
        const transitionDuration = parseFloat(this.dataset.transition) || 0.5;

        this.interval = setInterval(() => {
          this.rotateMessages(transitionDuration);
        }, intervalSeconds * 1000);
      }

      rotateMessages(transitionDuration) {
        const currentMessage = this.messages[this.currentIndex];
        currentMessage.classList.remove('active');

        this.currentIndex = (this.currentIndex + 1) % this.messages.length;

        setTimeout(() => {
          const nextMessage = this.messages[this.currentIndex];
          nextMessage.classList.add('active');
        }, transitionDuration * 1000);
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }
    }

    customElements.define('announcement-bar-{{ ai_gen_id }}', AnnouncementBar{{ ai_gen_id }});
  })();
</script>


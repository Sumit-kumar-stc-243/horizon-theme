{% doc %}
  @prompt
    create a dyanmic anoucement bar to accept multiple text and show in animations also ask time means how many sec change the text with proper animations and also add social media links , and number and also give one option show or not suppose we are not showing social media icon in mobile so we can hide easily, in message we can also add link
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    overflow: hidden;
    position: relative;
  }

  .ai-announcement-bar__wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    max-width: 100%;
    margin: 0 auto;
    gap: 20px;
  }

  .ai-announcement-bar__content-{{ ai_gen_id }} {
    flex: 1;
    text-align: center;
    position: relative;
    min-height: 24px;
  }

  .ai-announcement-bar__message-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    transition: opacity {{ block.settings.transition_duration }}s ease-in-out;
    font-size: {{ block.settings.font_size }}px;
  }

  .ai-announcement-bar__message-{{ ai_gen_id }}.active {
    opacity: 1;
    position: relative;
  }

  .ai-announcement-bar__message-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: {{ block.settings.link_style }};
  }

  .ai-announcement-bar__message-{{ ai_gen_id }} a:hover {
    opacity: 0.8;
  }

  .ai-announcement-bar__social-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .ai-announcement-bar__phone-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-size: {{ block.settings.font_size }}px;
  }

  .ai-announcement-bar__phone-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-announcement-bar__social-links-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
  }

  .ai-announcement-bar__social-link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.text_color }};
    transition: opacity 0.3s ease;
  }

  .ai-announcement-bar__social-link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-announcement-bar__social-link-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar__wrapper-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 12px;
    }

    {% if block.settings.hide_social_mobile %}
      .ai-announcement-bar__social-{{ ai_gen_id }} {
        display: none;
      }
    {% endif %}

    {% if block.settings.hide_phone_mobile %}
      .ai-announcement-bar__phone-{{ ai_gen_id }} {
        display: none;
      }
    {% endif %}
  }
{% endstyle %}

<announcement-bar-{{ ai_gen_id }}
  class="ai-announcement-bar-{{ ai_gen_id }}"
  data-interval="{{ block.settings.rotation_interval }}"
  data-transition="{{ block.settings.transition_duration }}"
  {{ block.shopify_attributes }}
>
  
</announcement-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class AnnouncementBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.messages = [];
        this.interval = null;
      }

      connectedCallback() {
        this.messages = Array.from(this.querySelectorAll('.ai-announcement-bar__message-{{ ai_gen_id }}'));
        
        if (this.messages.length <= 1) {
          return;
        }

        const intervalSeconds = parseInt(this.dataset.interval) || 5;
        const transitionDuration = parseFloat(this.dataset.transition) || 0.5;

        this.interval = setInterval(() => {
          this.rotateMessages(transitionDuration);
        }, intervalSeconds * 1000);
      }

      rotateMessages(transitionDuration) {
        const currentMessage = this.messages[this.currentIndex];
        currentMessage.classList.remove('active');

        this.currentIndex = (this.currentIndex + 1) % this.messages.length;

        setTimeout(() => {
          const nextMessage = this.messages[this.currentIndex];
          nextMessage.classList.add('active');
        }, transitionDuration * 1000);
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }
    }

    customElements.define('announcement-bar-{{ ai_gen_id }}', AnnouncementBar{{ ai_gen_id }});
  })();
</script>


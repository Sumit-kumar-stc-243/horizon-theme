<style>
  .custom-heading{
    position:absolute;
    top:{{ section.settings.top }}px;
    bottom:{{ section.settings.bottom }}px;
    left:{{ section.settings.left }}px;
    right: {{ section.settings.right }}px;
    font-weight: {{ section.settings.weight }};
    z-index:11;
   }
</style>

<h1 class="custom-heading">
  {{ block.settings.heading }}
</h1>

{% javascript %}
{% endjavascript %}

{% schema %}
{
  "name": "custom-heading",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Add Heading"
    },
    {
      "type": "range",
      "id": "top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "label": "Top"
    },
    {
      "type": "range",
      "id": "bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "label": "Bottom"
    },
    {
      "type": "range",
      "id": "left",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "label": "Left"
    },
    {
      "type": "range",
      "id": "right",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "label": "Right"
    },
    {
      "type": "range",
      "id": "weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 400,
      "label": "Font Weight"
    }
  ],
  "blocks": [],
  "presets": [{ "name": "custom heading" }]
}
{% endschema %}

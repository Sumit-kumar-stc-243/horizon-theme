{% style %}
.hero-section {
  position: relative;
  min-height: 400px;
  display: flex;
  align-items: center;
}

.hero-bg {
  position: absolute;
  inset: 0;
  z-index: -1;
}

.hero-bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-content {
  width: 100%;
  text-align: center;
  padding: 40px;
}

.hero-button {
  display: inline-block;
  margin-top: 20px;
  padding: 12px 24px;
  background: black;
  color: white;
  text-decoration: none;
}
{% endstyle %}

<div class="hero-section">

  {% if section.settings.hero_image != blank %}
    <div class="hero-bg">
      <img
        src="{{ section.settings.hero_image | image_url: width: 2000 }}"
        alt="{{ section.settings.hero_image.alt | escape }}"
        loading="lazy"
      >
    </div>
  {% endif %}

  <div class="hero-content">
    {% for block in section.blocks %}
      {% case block.type %}

        {% when 'heading' %}
          <h1 {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </h1>

        {% when 'text' %}
          <div {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>

        {% when 'button' %}
          <a
            href="{{ block.settings.link }}"
            class="hero-button"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.label }}
          </a>

      {% endcase %}
    {% endfor %}
  </div>

</div>

{% schema %}
{
  "name": "Hero section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Background image"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading text",
          "default": "Hero heading"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Hero description goes here.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero section",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}

{% style %}
  .hero-section {
    position:relative;
  }
  .hero-section-image {
    position:absolute;
    width: 100%;
    height: 400px;
  }
{% endstyle %}

<div class="hero-section">
  <img
    class="hero-section-image"
    src="{{ section.settings.hero-section-image | image_url: width: 2000  }}"
    height=""
    width=""
  >
</div>

{% javascript %}
{% endjavascript %}

{% schema %}
{
  "name": "hero section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero-section-image",
      "label": "Background Image"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Hero Section "
    }
  ]
}
{% endschema %}
